# Uvicorn --env-file: run the app against the TOP-10 real-data staging DB
# instead of the demo seed. Path is relative to the repo root (uvicorn cwd).
# Contains no secrets — only a file path. Switch back by starting the plain
# "jiguur" launch config, which uses the default jiguur.db.
#
# `jiguur-top10.next.db` = 2026-09-05-ны ДАХИН угсралт (OB нь хуудаснаас,
# billing_from, тэмдэглэлийн бодлого, талбайн хуваалт, агуулахын труба,
# каталогийн демо үнэ арилсан). Хуучин `jiguur-top10.db` (2026-09-04) хэвээр —
# буцаах бол доорх мөрийг тэр файл руу заа.
DATABASE_URL=sqlite:///system/backend/jiguur-top10.next.db
